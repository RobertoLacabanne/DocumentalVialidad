# Copiá este archivo como .env.local y completá con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API). Las dos son públicas: la seguridad la dan
# las políticas de la base, no el secreto de estas claves.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Solo para desarrollo local y pruebas automáticas: muestra un acceso con correo
# y contraseña además de "Entrar con Google". En producción, dejalo vacío.
VITE_ACCESO_CON_CLAVE=
